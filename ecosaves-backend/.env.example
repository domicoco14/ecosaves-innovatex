# =======================================================
# EcoSaves Backend Environment Variables Template
# Copy this file to `.env` in the `ecosaves-backend/` directory
# =======================================================

APP_ENV=development
APP_NAME=EcoSaves API

# -------------------------------------------------------
# Supabase Configuration (Get from Supabase Dashboard -> Settings -> API)
# -------------------------------------------------------
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE
SUPABASE_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY_HERE
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# -------------------------------------------------------
# JWT Authentication Security
# -------------------------------------------------------
# Pick any secret random text for JWT_SECRET (e.g. ecosaves_secret_jwt_key_2026)
JWT_SECRET=YOUR_RANDOM_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------
# OTP Email Settings (Resend API)
# -------------------------------------------------------
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=onboarding@resend.dev

# -------------------------------------------------------
# Ecobank Blaze API (Optional for early testing)
# -------------------------------------------------------
BLAZE_BASE_URL=https://api.ecobank.com/blaze/v1
BLAZE_CLIENT_ID=
BLAZE_CLIENT_SECRET=

# -------------------------------------------------------
# CORS Security
# -------------------------------------------------------
CORS_ORIGINS=["*"]
